<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="384.0" prefWidth="494.0" type="AnchorPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jabref.gui.forgesynesis.ForgeSynesisView">
   <children>
      <Group layoutX="277.0" layoutY="179.0">
         <children>
            <ToggleButton fx:id="languageSwitch" layoutY="14.0" mnemonicParsing="false" onAction="#changeLanguage" prefHeight="25.0" prefWidth="190.0" text="Deutsch" />
            <ToggleButton fx:id="quantitySwitch" layoutY="39.0" mnemonicParsing="false" onAction="#changeQuantity" prefHeight="25.0" prefWidth="190.0" text="10" />
            <ToggleButton fx:id="difficultySwitch" layoutY="64.0" mnemonicParsing="false" onAction="#changeDifficulty" prefHeight="25.0" prefWidth="190.0" text="Easy" />
            <ToggleButton layoutY="89.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="190.0" text="ToggleButton" />
         </children>
      </Group>
      <TextArea layoutX="30.0" layoutY="50.0" prefHeight="102.0" prefWidth="437.0" />
      <ScrollPane layoutX="30.0" layoutY="165.0" prefHeight="200.0" prefWidth="236.0">
         <content>
            <VBox prefHeight="200.0" prefWidth="175.0">
               <children>
                  <CheckBox mnemonicParsing="false" prefHeight="17.0" prefWidth="221.0" text="CheckBox" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <Button fx:id="forgeButton" layoutX="384.0" layoutY="332.0" mnemonicParsing="false" onAction="#forgeLearningCards" prefHeight="25.0" prefWidth="83.0" text="Forge" />
   </children>
</fx:root>
