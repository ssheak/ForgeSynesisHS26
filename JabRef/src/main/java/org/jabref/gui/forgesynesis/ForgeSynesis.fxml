<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>


<fx:root type="AnchorPane"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.jabref.gui.forgesynesis.ForgeSynesisView"
         prefHeight="400.0"
         prefWidth="600.0">
   <children>
      <Group layoutX="367.0" layoutY="188.0">
         <children>
            <ToggleButton layoutY="14.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="190.0" text="Deutsch" fx:id = "languageSwitch" onAction="#changeLanguage"/>
            <ToggleButton layoutY="39.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="190.0" fx:id = "quantitySwitch" text="10" onAction="#changeQuantity"/>
            <ToggleButton layoutY="64.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="190.0" fx:id = "difficultySwitch" text="Easy" onAction="#changeDifficulty"/>
            <ToggleButton layoutY="89.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="190.0" text="ToggleButton" />
         </children>
      </Group>
      <TextArea layoutX="30.0" layoutY="50.0" prefHeight="102.0" prefWidth="540.0" />
      <ScrollPane layoutX="30.0" layoutY="165.0" prefHeight="200.0" prefWidth="236.0">
         <content>
            <VBox prefHeight="200.0" prefWidth="223.0">
               <children>
                  <CheckBox mnemonicParsing="false" prefHeight="17.0" prefWidth="221.0" text="CheckBox" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
      <Button layoutX="474.0" layoutY="340.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="83.0" text="Forge" fx:id = "forgeButton" onAction="#forgeLearningCards"/>
   </children>
</fx:root>
