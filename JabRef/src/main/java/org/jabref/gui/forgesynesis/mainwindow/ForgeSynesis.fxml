<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="384.0" prefWidth="494.0" type="AnchorPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.jabref.gui.forgesynesis.mainwindow.ForgeSynesisView">
   <children>
      <Group layoutX="277.0" layoutY="179.0" />
      <TextArea layoutX="30.0" layoutY="50.0" prefHeight="102.0" prefWidth="437.0" promptText="Enter an additional topic or instructions..."/>
      <ScrollPane fx:id="previewPane" fitToWidth="true" layoutX="30.0" layoutY="187.0" prefHeight="157.0" prefWidth="236.0">

         <content>
            <VBox fx:id="previewBox" prefWidth="175.0" spacing="10.0" />
         </content>

      </ScrollPane>
      <Button fx:id="forgeButton" layoutX="384.0" layoutY="332.0" mnemonicParsing="false" onAction="#forgeLearningCards" prefHeight="25.0" prefWidth="83.0" text="Forge" />
      <Button fx:id="deckButton" layoutX="277.0" layoutY="332.0" mnemonicParsing="false" onAction="#openDeckPreview" prefHeight="25.0" prefWidth="83.0" text="Deck" />
      <ToggleButton fx:id="languageSwitch" layoutX="277.0" layoutY="187.0" mnemonicParsing="false" onAction="#changeLanguage" prefHeight="25.0" prefWidth="190.0" text="Deutsch" />
      <ToggleButton fx:id="quantitySwitch" layoutX="277.0" layoutY="212.0" mnemonicParsing="false" onAction="#changeQuantity" prefHeight="25.0" prefWidth="190.0" text="10" />
      <ToggleButton fx:id="difficultySwitch" layoutX="277.0" layoutY="237.0" mnemonicParsing="false" onAction="#changeDifficulty" prefHeight="25.0" prefWidth="190.0" text="Easy" />
   </children>
</fx:root>
